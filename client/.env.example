# Optional. Base URL for the Socket.IO connection.
#
# If unset:
#   - In dev (`npm run dev`), the socket connects to the same origin
#     ("/"), so it goes through the "/socket.io" proxy already defined
#     in vite.config.js (-> http://localhost:5000). This makes local dev
#     talk to your local backend/DB by default.
#   - In a production build, it falls back to the deployed backend URL
#     hardcoded in src/context/SocketContext.jsx.
#
# Set this explicitly if your setup differs — e.g. testing against the
# deployed backend from local dev, or a backend URL that changes between
# environments.
# VITE_SOCKET_URL=https://your-backend.onrender.com

# Optional. Base URL for REST API calls (see src/services/api.js).
# Defaults to "/api" (relative), which relies on the "/api" proxy in
# vite.config.js during dev, or same-origin routing in production.
# VITE_API_URL=https://your-backend.onrender.com/api
